# انسخ هذا الملف إلى .env واملأ القيم الحقيقية. لا تضف .env نفسه لـ git.

# رابط اتصال Supabase PostgreSQL (انسخه من Project Settings -> Database -> Connection string)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.dwhvgxilxzmxatwejfmu.supabase.co:5432/postgres

# رابط الويب هوك لوركفلو الوكلاء الثمانية على n8n
# (Webhook node بملف Aman_AI_Master_Workflow.json — path: report-agent)
# مثال: https://your-n8n-host.example.com/webhook/report-agent
N8N_WEBHOOK_URL=

# مهلة انتظار رد n8n بالثواني (اختياري)
N8N_WEBHOOK_TIMEOUT=15

# رابط الباك-إند العام (بدون / بالنهاية) — يُستخدم لبناء رابط كامل للصورة
# المرفقة يرسل لوكيل تحليل الصورة (Agent8) على n8n، لأنه لا يصل لمسارات نسبية.
# مثال: https://aman-ai-backend.onrender.com
PUBLIC_BASE_URL=

# سر مشترك بين الباك-إند ووركفلو n8n لتوثيق استدعاء
# PATCH /api/reports/{id}/classification (يمنع أي طرف خارجي من تعديل تصنيف البلاغات)
# ضع نفس القيمة بعقدة "HTTP Request" الأخيرة بوركفلو n8n كـ Header x-webhook-secret
N8N_CALLBACK_SECRET=

# نطاقات مسموح لها بالوصول عبر CORS، مفصولة بفواصل. اتركها * فقط أثناء التطوير.
ALLOWED_ORIGINS=*

# ============== أضيفت مع تعديلات الأمان ==============

# بيئة التشغيل: development | production
# بوضع production يرفض الباك-إند الإقلاع إذا كان الإعداد غير آمن
# (CORS مفتوح، أو سر n8n فارغ، أو أكواد موظفين افتراضية فعّالة)
ENVIRONMENT=development

# تجاوز فحص الإقلاع الآمن مؤقتًا (لا تستخدمه إلا وأنت تعرف السبب)
ALLOW_INSECURE=false

# حجم تجمّع اتصالات قاعدة البيانات
DB_POOL_MIN=1
DB_POOL_MAX=10

# حدود الرفع
MAX_IMAGE_MB=5
MAX_AUDIO_MB=10
MAX_MEDIA_FILES=4

# تحديد معدّل الطلبات — الصيغة: عدد/ثواني
RATE_LIMIT_ENABLED=true
RATE_REPORTS_CREATE=5/300
RATE_AUTH_LOGIN=10/300
RATE_AUTH_REGISTER=5/3600
RATE_REPORTS_PUBLIC=60/60

# عدد محاولات استدعاء n8n قبل الاستسلام
N8N_MAX_ATTEMPTS=3

# أكواد موظفين للتجربة المحلية فقط (تُتجاهل بوضع الإنتاج)
# الصيغة: كود:الاسم:القسم:is_admin  — مفصولة بفواصل
# SEED_STAFF_CODES=DEV-ADMIN-x9f2:المدير العام::true,DEV-POL-k3m8:عمليات الشرطة:Police:false

# ============== إرسال رموز التحقق ==============
# console = طباعة بالسجلات (تطوير فقط) | resend = بريد | twilio = SMS
NOTIFY_PROVIDER=console

# Resend (بريد) — سجّلي بـ resend.com واحصلي على مفتاح
RESEND_API_KEY=
RESEND_FROM=Aman AI <onboarding@resend.dev>

# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ============== Redis (اختياري لكن مهم بالإنتاج) ==============
# بدونه يصير حد المعدّل خاصًا بكل عملية ويُصفَّر مع كل نشر
REDIS_URL=

# ============== عامل إعادة محاولة خط الوكلاء ==============
N8N_MAX_ATTEMPTS=5
N8N_RETRY_SWEEP_SECONDS=60
N8N_RETRY_WORKER=true

# ============== كشف البلاغات المكررة ==============
# بلاغان من نفس النوع خلال هذه النافذة وضمن هذا النطاق = حادث واحد
DEDUP_ENABLED=true
DEDUP_RADIUS_M=500
DEDUP_WINDOW_MINUTES=20

# ============== التحويل الجغرافي (Nominatim) ==============
# مجاني بلا مفتاح. شروط الاستخدام: User-Agent معرِّف + طلب واحد بالثانية
GEOCODE_ENABLED=true
NOMINATIM_URL=https://nominatim.openstreetmap.org/reverse
NOMINATIM_USER_AGENT=AmanAI-EmergencyPlatform/1.0
GEOCODE_TIMEOUT=8
